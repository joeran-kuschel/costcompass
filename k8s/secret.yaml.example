# Example only. Copy to k8s/secret.yaml (ignored by git) and replace every "change-me".
# Kubernetes Secrets are base64, not encrypted: use values for this local cluster only.
apiVersion: v1
kind: Secret
metadata:
  name: costcompass-db
  namespace: costcompass
type: Opaque
stringData:
  # Read by the Postgres pod (#45)
  POSTGRES_USER: costcompass
  POSTGRES_PASSWORD: change-me
  POSTGRES_DB: costcompass
  # Read by the migrations Job (#47).
  MIGRATE_DATABASE_URL: postgresql://costcompass:change-me@postgres:5432/costcompass
  # Restricted app user: created by the migrations Job
  APP_DB_PASSWORD: change-me
  # Used by the app
  NUXT_DATABASE_URL: postgresql://costcompass_app:change-me@postgres:5432/costcompass
