# Example only. Copy to k8s/secret.yaml (ignored by git) and replace every "change-me".
# Kubernetes Secrets are base64, not encrypted: use values for this local cluster only.
apiVersion: v1
kind: Secret
metadata:
  name: costcompass-db
  namespace: costcompass
type: Opaque
stringData:
  # Read by the Postgres pod (#45)
  POSTGRES_USER: costcompass
  POSTGRES_PASSWORD: change-me
  POSTGRES_DB: costcompass
  # Read by the app (#46) and the migrations Job (#47).
  # User, password and database must be the same as above; the host is the Postgres Service name (#45).
  NUXT_DATABASE_URL: postgresql://costcompass:change-me@postgres:5432/costcompass
